    "inputSchema": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      },
      "additionalProperties": false,
      "required": [
        "channel",
        "value"
      ]
    }
  },
  {
    "name": "doll_set_led",
