      ]
    }
  },
  {
    "name": "get_channel_capabilities",
    "description": "Read pressure/switch input drivers, port modes and GPIO limits. This firmware has no temperature, motion or actuator drivers.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "get_channel_config",
    "description": "Read persistent logical channel types, body labels, drivers, bindings and calibration. IDs independent of MUX ports.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "set_channel_state",
    "description": "Persist one input port as off, simulation or connected; optional body name. Preserve other ports, calibration and wiring. Connected is installed configuration, not electrical detection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "simulation",
            "connected"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "channel"
      ]
    }
  },
  {
    "name": "read_channel_values",
    "description": "Read typed values with units, source, quality and age. Output readings report commanded state, not motor feedback.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "set_input_enabled",
    "description": "Legacy temporary physical-input override. Prefer set_channel_state for persistent per-port modes; preserves thresholds.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    }
  },
  {
    "name": "capture_pressure_calibration",
    "description": "Capture real pressure only: stage 0 idle, 1 light, 2 strong. Suppress selected channel touch events during calibration; capture nonblocking, expires after 60s inactivity. No automatic save.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        }
      },
      "additionalProperties": false,
      "required": [
        "channel",
        "stage"
      ]
    }
  },
  {
    "name": "get_pressure_calibration",
    "description": "Read capture progress/statistics and recommended hysteresis thresholds. Missing sensors, insufficient separation or ADC saturation prevent saving.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "apply_pressure_calibration",
    "description": "Explicitly persist recommended thresholds for the calibrated pressure channel only; other configuration and output state are preserved.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "cancel_pressure_calibration",
    "description": "Cancel capture without changing saved thresholds; resume ordinary event generation.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "set_channel_config",
    "description": "Replace pressure/switch channel configuration; explicit modes resume connected inputs. Preserve calibration and retired settings. Prefer set_channel_state for one port.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "channel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "pressure",
                  "switch"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "off",
                  "simulation",
                  "connected"
                ]
              },
              "driver": {
                "type": "string",
                "enum": [
                  "simulation",
                  "mux_adc",
                  "gpio_adc",
                  "gpio_switch"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "input"
                ]
              },
              "mux_port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "gpio": {
                "type": "integer"
              },
              "options": {
                "type": "object"
              }
            },
            "required": [
              "channel",
              "name",
              "type",
              "driver"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "channels"
      ]
    }
  },
  {
    "name": "simulate_channel_input",
    "description": "Simulate an enabled pressure or dry-contact input configured in simulation mode; never drives physical outputs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "adc_raw",
            "boolean"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "channel",
        "value"
      ]
    }
  },
