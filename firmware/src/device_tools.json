        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
